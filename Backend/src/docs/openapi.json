{
  "openapi": "3.0.3",
  "info": {
    "title": "SportClub API",
    "version": "1.0.0",
    "description": "API del challenge FullStack Mobile. Para probar el perfil: ejecutá POST /api/auth/login con el usuario demo, copiá token y pegalo en Authorize (sin el prefijo Bearer). Los endpoints públicos no requieren autenticación. Los cuerpos JSON admiten hasta 16 KB."
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor actual"
    }
  ],
  "tags": [
    {
      "name": "Estado"
    },
    {
      "name": "Autenticación"
    },
    {
      "name": "Perfil"
    },
    {
      "name": "Sedes"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Estado"
        ],
        "operationId": "getHealth",
        "summary": "Consultar estado del servidor",
        "responses": {
          "200": {
            "description": "Servidor disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "operationId": "login",
        "summary": "Iniciar sesión",
        "description": "Devuelve un JWT válido por una hora. Máximo 20 solicitudes cada 15 minutos por IP. El email se normaliza a minúsculas.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "email": "demo@sportclub.com",
                "password": "SportClub123!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sesión iniciada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos o JSON mal formado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "Ingresá un email y una contraseña válidos."
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciales incorrectas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "INVALID_CREDENTIALS",
                    "message": "Email o contraseña incorrectos."
                  }
                }
              }
            }
          },
          "413": {
            "description": "El cuerpo supera 16 KB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "request entity too large"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Límite de solicitudes alcanzado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "TOO_MANY_REQUESTS",
                    "message": "Demasiados intentos. Intentá más tarde."
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Ocurrió un error interno."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "tags": [
          "Perfil"
        ],
        "operationId": "getProfile",
        "summary": "Obtener el perfil autenticado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil del usuario.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                },
                "example": {
                  "data": {
                    "id": "user-demo",
                    "firstName": "Alex",
                    "lastName": "García",
                    "email": "demo@sportclub.com",
                    "phone": ""
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido, vencido o usuario inexistente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "Token inválido o vencido."
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Ocurrió un error interno."
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Perfil"
        ],
        "operationId": "updateProfile",
        "summary": "Actualizar el perfil autenticado",
        "description": "Enviar al menos un campo. No permite editar email, contraseña ni identificador. Los cambios persisten en JSON.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileUpdate"
              },
              "example": {
                "firstName": "Fernando",
                "phone": "+54 11 1234 5678"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Perfil actualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                },
                "example": {
                  "data": {
                    "id": "user-demo",
                    "firstName": "Fernando",
                    "lastName": "García",
                    "email": "demo@sportclub.com",
                    "phone": "+54 11 1234 5678"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Campos inválidos, desconocidos o cuerpo vacío.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "Campos permitidos: firstName, lastName y phone."
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido, vencido o usuario inexistente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "Token inválido o vencido."
                  }
                }
              }
            }
          },
          "413": {
            "description": "El cuerpo supera 16 KB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "request entity too large"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Ocurrió un error interno."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/venues": {
      "get": {
        "tags": [
          "Sedes"
        ],
        "operationId": "listVenues",
        "summary": "Listar las dos sedes y sus clases",
        "description": "Acceso público. Sedes ficticias de demostración, con dos clases cada una.",
        "responses": {
          "200": {
            "description": "Listado de sedes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VenuesResponse"
                },
                "example": {
                  "data": [
                    {
                      "id": "palermo",
                      "name": "SportClub Palermo",
                      "address": "Av. Santa Fe 4500, CABA",
                      "location": {
                        "latitude": -34.577,
                        "longitude": -58.426
                      },
                      "description": "Sede de demostración con espacios para entrenamiento y clases grupales.",
                      "openingHours": [
                        {
                          "days": [
                            "monday",
                            "tuesday",
                            "wednesday",
                            "thursday",
                            "friday"
                          ],
                          "opens": "07:00",
                          "closes": "22:00"
                        },
                        {
                          "days": [
                            "saturday"
                          ],
                          "opens": "09:00",
                          "closes": "18:00"
                        }
                      ],
                      "classes": [
                        {
                          "id": "palermo-1",
                          "name": "Yoga",
                          "description": "Clase grupal de yoga guiada por un instructor.",
                          "days": [
                            "monday",
                            "wednesday",
                            "friday"
                          ],
                          "times": [
                            "09:00",
                            "18:00"
                          ]
                        },
                        {
                          "id": "palermo-2",
                          "name": "Spinning",
                          "description": "Clase grupal de spinning guiada por un instructor.",
                          "days": [
                            "tuesday",
                            "thursday"
                          ],
                          "times": [
                            "10:00",
                            "19:00"
                          ]
                        }
                      ]
                    },
                    {
                      "id": "belgrano",
                      "name": "SportClub Belgrano",
                      "address": "Av. Cabildo 2000, CABA",
                      "location": {
                        "latitude": -34.562,
                        "longitude": -58.456
                      },
                      "description": "Sede de demostración con espacios para entrenamiento y clases grupales.",
                      "openingHours": [
                        {
                          "days": [
                            "monday",
                            "tuesday",
                            "wednesday",
                            "thursday",
                            "friday"
                          ],
                          "opens": "07:00",
                          "closes": "22:00"
                        },
                        {
                          "days": [
                            "saturday"
                          ],
                          "opens": "09:00",
                          "closes": "18:00"
                        }
                      ],
                      "classes": [
                        {
                          "id": "belgrano-1",
                          "name": "Funcional",
                          "description": "Clase grupal de funcional guiada por un instructor.",
                          "days": [
                            "monday",
                            "wednesday",
                            "friday"
                          ],
                          "times": [
                            "09:00",
                            "18:00"
                          ]
                        },
                        {
                          "id": "belgrano-2",
                          "name": "Pilates",
                          "description": "Clase grupal de pilates guiada por un instructor.",
                          "days": [
                            "tuesday",
                            "thursday"
                          ],
                          "times": [
                            "10:00",
                            "19:00"
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/venues/{id}": {
      "get": {
        "tags": [
          "Sedes"
        ],
        "operationId": "getVenue",
        "summary": "Consultar una sede",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identificador de la sede (palermo o belgrano).",
            "schema": {
              "type": "string"
            },
            "example": "palermo"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle de sede.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VenueResponse"
                },
                "example": {
                  "data": {
                    "id": "palermo",
                    "name": "SportClub Palermo",
                    "address": "Av. Santa Fe 4500, CABA",
                    "location": {
                      "latitude": -34.577,
                      "longitude": -58.426
                    },
                    "description": "Sede de demostración con espacios para entrenamiento y clases grupales.",
                    "openingHours": [
                      {
                        "days": [
                          "monday",
                          "tuesday",
                          "wednesday",
                          "thursday",
                          "friday"
                        ],
                        "opens": "07:00",
                        "closes": "22:00"
                      },
                      {
                        "days": [
                          "saturday"
                        ],
                        "opens": "09:00",
                        "closes": "18:00"
                      }
                    ],
                    "classes": [
                      {
                        "id": "palermo-1",
                        "name": "Yoga",
                        "description": "Clase grupal de yoga guiada por un instructor.",
                        "days": [
                          "monday",
                          "wednesday",
                          "friday"
                        ],
                        "times": [
                          "09:00",
                          "18:00"
                        ]
                      },
                      {
                        "id": "palermo-2",
                        "name": "Spinning",
                        "description": "Clase grupal de spinning guiada por un instructor.",
                        "days": [
                          "tuesday",
                          "thursday"
                        ],
                        "times": [
                          "10:00",
                          "19:00"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          "404": {
            "description": "La sede no existe.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "NOT_FOUND",
                    "message": "Sede no encontrada."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Pegá el token devuelto por login, sin escribir Bearer."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "user-demo"
          },
          "firstName": {
            "type": "string",
            "example": "Alex"
          },
          "lastName": {
            "type": "string",
            "example": "García"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "demo@sportclub.com"
          },
          "phone": {
            "type": "string",
            "example": "+54 11 1234 5678"
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "phone"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT HS256 válido durante una hora."
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "integer",
            "example": 3600,
            "description": "Duración en segundos."
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "token",
          "tokenType",
          "expiresIn",
          "user"
        ]
      },
      "ProfileUpdate": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Se recortan espacios; no puede quedar vacío."
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Se recortan espacios; no puede quedar vacío."
          },
          "phone": {
            "type": "string",
            "pattern": "^$|^\\+?[0-9 ()-]{6,25}$",
            "description": "Vacío para borrar; admite números, espacios, paréntesis, guiones y + inicial."
          }
        },
        "minProperties": 1,
        "additionalProperties": false
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "data"
        ]
      },
      "Location": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "latitude",
          "longitude"
        ]
      },
      "OpeningHours": {
        "type": "object",
        "properties": {
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Day"
            },
            "minItems": 1
          },
          "opens": {
            "$ref": "#/components/schemas/Time"
          },
          "closes": {
            "$ref": "#/components/schemas/Time"
          }
        },
        "required": [
          "days",
          "opens",
          "closes"
        ]
      },
      "Day": {
        "type": "string",
        "enum": [
          "monday",
          "tuesday",
          "wednesday",
          "thursday",
          "friday",
          "saturday",
          "sunday"
        ]
      },
      "Time": {
        "type": "string",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
        "example": "09:00",
        "description": "Hora local de Buenos Aires (HH:mm)."
      },
      "SportClass": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Day"
            },
            "minItems": 1
          },
          "times": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Time"
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "days",
          "times"
        ]
      },
      "Venue": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "description": {
            "type": "string"
          },
          "openingHours": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpeningHours"
            }
          },
          "classes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SportClass"
            }
          }
        },
        "required": [
          "id",
          "name",
          "address",
          "location",
          "description",
          "openingHours",
          "classes"
        ]
      },
      "VenueResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Venue"
          }
        },
        "required": [
          "data"
        ]
      },
      "VenuesResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Venue"
            }
          }
        },
        "required": [
          "data"
        ]
      }
    }
  }
}
